# Supabase project URL; public and not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key for browser and cookie-bound clients; public, RLS protected.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public base URL used to build verification links; not a secret.
NEXT_PUBLIC_VERIFY_BASE_URL=https://verify.thoorigai.in

# Canonical public application URL; not a secret.
NEXT_PUBLIC_APP_URL=https://thoorigai.in

# Supabase service role key; SECRET. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Optional monitoring DSN; configure only when monitoring is enabled.
SENTRY_DSN=
