# Supabase project URL; public and not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key for browser and cookie-bound clients; public, RLS protected.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public base URL used to build verification links; not a secret.
NEXT_PUBLIC_VERIFY_BASE_URL=https://verify.thoorigai.in

# Canonical public application URL; not a secret.
NEXT_PUBLIC_APP_URL=https://thoorigai.in

# Supabase service role key; SECRET. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Optional Sentry DSN; public event-ingest endpoint, safe for browser use.
NEXT_PUBLIC_SENTRY_DSN=

# Optional server-only Sentry DSN. Secret-management recommended for deployment configuration.
SENTRY_DSN=

# Build-time Sentry source-map upload credentials; set only in protected GitHub Environments.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Release and environment tags; set by CI/Vercel, not manually in production.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
