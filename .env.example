# ======================================================================
# Supabase project connection
# Copy this file to `.env.local` (never commit real keys) and fill values.
# ======================================================================

# Public project URL — needed by both the server AND (for future auth) browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable anon key — safe to expose to the browser (used with RLS).
# Required once you enable Supabase Auth or use client-side data fetching.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key — bypasses RLS. Use ONLY inside
# Next.js route handlers (app/api/**) and server-only lib code.
# ⚠️ NEVER prefix with NEXT_PUBLIC_ or send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
