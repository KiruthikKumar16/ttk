{
  "name": "thoorigai-admin-dashboard",
  "version": "0.1.0",
  "description": "Internal administration dashboard for ThoorigAI Infotech",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:budget": "node scripts/check-build-budget.mjs",
    "build:client-budget": "node scripts/check-client-bundle.mjs",
    "build:analyze": "node scripts/build-analyze.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "test:db": "pnpm db:test",
    "test:e2e": "playwright test",
    "test:ci": "node scripts/test-ci.mjs",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "sentry:smoke": "node scripts/sentry-smoke.mjs",
    "check:workflow-pins": "node scripts/check-workflow-pins.mjs",
    "format:check": "prettier --check .",
    "markdownlint": "markdownlint-cli2 README.md SECURITY.md PULL_REQUEST_TEMPLATE.md \"docs/**/*.md\" \".github/**/*.md\"",
    "docs:permissions": "node scripts/generate-permissions-doc.mjs",
    "docs:permissions:check": "node scripts/generate-permissions-doc.mjs --check",
    "docs:screenshots": "node scripts/capture-doc-screenshots.mjs",
    "docs:manuals": "node scripts/build-manuals.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:types": "node scripts/db-types.mjs",
    "db:types:check": "node scripts/db-types.mjs --check",
    "db:lint": "supabase db lint --local --fail-on warning",
    "db:test": "supabase test db --local",
    "db:diff": "supabase db diff --local",
    "db:check-rls": "supabase db query --local --file scripts/check-public-rls.sql",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "11.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "pdf-lib": "1.17.1",
    "pino": "10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@next/bundle-analyzer": "16.3.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24",
    "@types/qrcode": "1.5.6",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@typescript-eslint/parser": "8.70.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "markdownlint-cli2": "0.23.3",
    "pdfjs-dist": "^6.3.289",
    "pino-pretty": "13.1.3",
    "playwright": "^1.63.0",
    "postcss": "^8.5",
    "prettier": "3.9.9",
    "shadcn": "^4.19.0",
    "simple-git-hooks": "^2.14.0",
    "supabase": "2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vercel": "61.0.0",
    "vitest": "5.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/secret-scan.mjs"
  }
}
